{
  "name": "@axion-neuralis/axion-ai-cli",
  "version": "1.0.2",
  "description": "AXION AI CLI \u2014 an interactive terminal AI agent with tools, provider integrations, conversation history, and local memory",
  "license": "GPL-3.0-or-later",
  "author": "axion",
  "bin": {
    "axion-ai-cli": "dist/index.js",
    "axion-cli": "dist/index.js",
    "axn-cli": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.copyFileSync('version.json','dist/version.json');fs.copyFileSync('update-info.json','dist/update-info.json');fs.copyFileSync('version-info.json','dist/version-info.json');try{fs.chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check": "npm test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "termux",
    "gemini",
    "gemma",
    "llm",
    "autonomous"
  ],
  "dependencies": {
    "axios": "1.7.2",
    "chalk": "4.1.2",
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "typescript": "5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azrielspace852-wq/axion-ai-agents-cli.git"
  },
  "homepage": "https://github.com/azrielspace852-wq/axion-ai-agents-cli#readme",
  "bugs": {
    "url": "https://github.com/azrielspace852-wq/axion-ai-agents-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
